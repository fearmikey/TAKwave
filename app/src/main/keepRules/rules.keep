# SPDX-License-Identifier: GPL-3.0-or-later
# R8 keep rules for TAKwave. AGP combines every *.keep file in src/main/keepRules.

# usb-serial-for-android (vendored in :usbserial) finds its driver classes by reflection:
# UsbSerialProber calls each driver's static getSupportedDevices() and its
# (UsbDevice) constructor through java.lang.reflect.
-keep class com.hoho.android.usbserial.driver.* { *; }

# kXML (:xmlparser) is instantiated directly (org.kxml2.io.KXmlParser), not through
# XmlPullParserFactory, so it needs no keep rule.
